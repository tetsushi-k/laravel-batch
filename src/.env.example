APP_NAME="Laravel Batch Monthly Report"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------
# データベース設定
# docker-compose.yml の db サービスと合わせること
# -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_batch
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# -----------------------------------------------------------
# キュー設定
# database ドライバを使用する（Redis 不要）
# `php artisan queue:work` で処理を開始する
# -----------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------
# メール設定（Mailtrap）
# https://mailtrap.io で取得した SMTP 認証情報を記入する
# Sandbox > SMTP Settings > PHP > Laravel 9+ の値を使用
# -----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
